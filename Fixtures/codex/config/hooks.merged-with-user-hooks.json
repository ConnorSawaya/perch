{
  "description": "User's own hooks; Perch appended one matcher group per event.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/alex/Library/Application Support/Perch/bin/perch-hook' --agent codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/alex/Library/Application Support/Perch/bin/perch-hook' --agent codex",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/alex/Library/Application Support/Perch/bin/perch-hook' --agent codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/.codex/hooks/block_rm_rf.py\"",
            "timeout": 30,
            "statusMessage": "Checking Bash command"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/alex/Library/Application Support/Perch/bin/perch-hook' --agent codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/alex/Library/Application Support/Perch/bin/perch-hook' --agent codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/alex/Library/Application Support/Perch/bin/perch-hook' --agent codex",
            "timeout": 86400,
            "statusMessage": "Waiting for a decision in Perch (notch)"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/alex/Library/Application Support/Perch/bin/perch-hook' --agent codex",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/alex/Library/Application Support/Perch/bin/perch-hook' --agent codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/alex/Library/Application Support/Perch/bin/perch-hook' --agent codex",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/alex/Library/Application Support/Perch/bin/perch-hook' --agent codex",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay /System/Library/Sounds/Glass.aiff"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/alex/Library/Application Support/Perch/bin/perch-hook' --agent codex",
            "timeout": 5
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/Users/alex/Library/Application Support/Perch/bin/perch-hook' --agent codex",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
