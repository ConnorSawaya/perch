{
  "perch": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "/bin/sh /Users/alex/.gemini/config/perch/hook.sh PreInvocation",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh /Users/alex/.gemini/config/perch/hook.sh PreToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh /Users/alex/.gemini/config/perch/hook.sh PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "/bin/sh /Users/alex/.gemini/config/perch/hook.sh PostInvocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "/bin/sh /Users/alex/.gemini/config/perch/hook.sh Stop",
        "timeout": 5
      }
    ]
  }
}
